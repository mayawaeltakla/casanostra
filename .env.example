# --- قاعدة البيانات (SQLite) ---
# المسار نسبي إلى ملف prisma/schema.prisma
DATABASE_URL=file:../db/custom.db

# --- واتساب الحجوزات (رقم تركي بصيغة دولية بدون +) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=905550000000

# --- لوحة تحكم المقالات (/admin) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password
# مفتاح تشفير الجلسة — أنشئه بأمر: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-random-64-hex-chars
