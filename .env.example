# ============================================================================
#  قالب متغيّرات البيئة — انسخه إلى .env ثم املأ القيم الحقيقية محلياً.
#  لا تضع أي بيانات اعتماد حقيقية في هذا الملف (فهو ملف عام يُشارَك).
#    cp .env.example .env
# ============================================================================

# --- قاعدة البيانات (PostgreSQL — Prisma Postgres) ---
# الصق هنا سلسلة الاتصال الخاصة بقاعدة Prisma Postgres (اسمها: prisma-postgres-red-globe).
# الشكل المتوقع (مثال توضيحي — ليس قيمة حقيقية):
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# أو صيغة Prisma Postgres المباشرة: prisma+postgres://...
# لا تضع سلسلة اتصال حقيقية في هذا الملف (فهو ملف عام يُشارَك).
DATABASE_URL=

# (اختياري) اتصال مباشر غير مُجمَّع للترحيلات — أضِفه فقط إذا منحك Prisma Postgres
# سلسلتين منفصلتين (مجمَّعة + مباشرة). اتركه معطّلاً إن لم تحتجه.
# DIRECT_URL=

# --- رقم واتساب للتواصل (بصيغة دولية بدون + أو أصفار بادئة) ---
# عام (يظهر في المتصفح). استبدل الرقم برقمك الحقيقي.
NEXT_PUBLIC_WHATSAPP_NUMBER=000000000000

# --- حساب الدخول إلى لوحة التحكم (/admin) ---
# يُنشأ أول مدير تلقائياً عند أول تسجيل دخول ناجح *فقط* إذا كان جدول AdminUser
# فارغاً. تغيير هذه القيم لاحقاً لا يغيّر كلمة مرور حساب موجود في القاعدة.
# اختر كلمة مرور قوية (16+ حرفاً) ولا تستخدم قيمة افتراضية.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- سر توقيع جلسة لوحة التحكم ---
# موصى به إلزامياً في الإنتاج: سلسلة عشوائية 32 بايت على الأقل.
#   openssl rand -hex 32
# إن تُرك فارغاً يُشتق السر تلقائياً من ADMIN_PASSWORD (يعمل لكنه أقل أماناً،
# وأي تغيير لكلمة المرور سيُبطل الجلسات القائمة).
ADMIN_SESSION_SECRET=

# --- الترجمة التلقائية للمقالات (اختياري) ---
# مفتاح مزوّد الذكاء الاصطناعي. إن تُرك فارغاً تُستخدم خدمة ترجمة مجانية،
# مع التنبيه إلى أن نصوص المقالات تُرسَل إلى خدمة خارجية عند الترجمة.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# TRANSLATE_MODEL=claude-haiku-4-5
